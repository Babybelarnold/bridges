<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.24" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.24" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="src\Bridges.Core\Bridges.Core.csproj" />
  </ItemGroup>

  <!-- The src/ folder holds sibling projects (Core, PackGen) referenced via ProjectReference.
       Exclude them from this project's own implicit source globbing. -->
  <ItemGroup>
    <Compile Remove="src\**\*.cs" />
    <Content Remove="src\**\*" />
    <None Remove="src\**\*" />
    <EmbeddedResource Remove="src\**\*" />
  </ItemGroup>

</Project>
